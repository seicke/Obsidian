<script>
function showDetails(btn) {
  const x = document.querySelector('.infoTable2');
  const nowShown = x.classList.toggle('show');
  if (btn) btn.textContent = nowShown ? 'Hide Details' : 'Help & Details';
}

function redirectToTicket() {
    // 1. Get your detected browser name
    let UserAgent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) obsidian/1.9.12 Chrome/138.0.7204.235 Electron/37.3.1 Safari/537.36";
    let bName = detectBrowserName(UserAgent);
    
    // 2. Base64 encode the browser name so it matches your other parameters
    let encodedBrowser = btoa(bName);

    // 3. Construct the URL using the Gateway variables (already encoded by MWG) 
    // and your new JS encoded variable
    let baseUrl = "http://sitereview.mwginternal.com/mwg-internal/sitereview";
    let params = "?"
               + "&user=RWlja2U="
               + "&categories=VGVjaG5pY2FsL0J1c2luZXNzIEZvcnVtcywgU29mdHdhcmUvSGFyZHdhcmU="
               + "&rule=QmxvY2sgSWYgVmlydXMgd2FzIEZvdW5kXzIwMTktMDItMjg="
               + "&blockres="
               + "&ruleset=R2F0ZXdheSBBbnRpLU1hbHdhcmU="
               + "&browser=" + encodedBrowser; // Adding your JS variable here

    // 4. Redirect
    location.href = baseUrl + params;
}

function detectBrowserName(ua) {
    ua = ua.toString();
    if (ua.includes("Edg/")) return "Microsoft Edge";
    if (ua.includes("Chrome/") && !ua.includes("Edg/")) return "Google Chrome";
    if (ua.includes("Firefox/")) return "Mozilla Firefox";
    if (ua.includes("Safari/") && !ua.includes("Chrome/")) return "Apple Safari";
    return "Unknown Browser";
}

</script>

